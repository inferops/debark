/dist/
/debark
/debark.exe
*.test
*.out
/tmp/

# Generated by `make man` / `make completions` (and .goreleaser.yaml's
# before-hook, which runs the same generators before packaging a release) —
# build output, not source. See Makefile.
/man/
/completions/

# Coverage profile from `make cover`.
/coverage.out
/.demo/

# Locally built helper binaries. `make matrix` and the signer plugin under
# hack/ produce these; they are build output, not source, and a public repo
# has no business carrying a committed executable.
/matrix
/matrix.exe
/signer-plugin
/signer-plugin.exe

# Output of the correctness experiments (hack/experiments/*.sh). Each script
# regenerates its own directory, and the writeups in docs/experiments/ record
# what the runs showed — several hundred MB of apt roots, repos and .deb
# fixtures do not belong in the repository.
/hack/experiments/out/

# UX capture snapshots. gui/hack/ui-review/snapshot.ps1 requires its
# destination to sit inside the directory above gui/ — which, since the
# desktop app moved into this repository, is this repository root. The
# conventional destination the ui-review docs use is .ux-work/snapshots/<name>.
# These are capture evidence for a review, not source, and they are large:
# each one copies the whole frontend plus a content manifest.
/.ux-work/

# Operator secrets and local bundle inputs/outputs.
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example
/bundle/
/operator.pub
/*.snapshot.tar.zst
/*.debark.tar.zst

# Editor and OS files (also applies outside gui/).
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
__pycache__/
